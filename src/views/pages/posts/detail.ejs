<%- include('../../layouts/main', { body: `
<div class="row">
    <div class="col-md-8">
        <!-- 帖子内容 -->
        <div class="card mb-4">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h4 class="mb-2">
                            <%= post.title %>
                            <% if (post.is_urgent) { %>
                            <span class="badge bg-danger ms-2">紧急</span>
                            <% } %>
                            <% if (post.is_resolved) { %>
                            <span class="badge bg-success ms-2">已解决</span>
                            <% } %>
                        </h4>
                        <div class="post-meta">
                            <img src="<%= post.avatar %>" alt="<%= post.username %>" class="user-avatar me-2">
                            <span class="me-3">
                                <i class="fas fa-user me-1"></i><%= post.username %>
                                <% if (post.real_name) { %>(<%= post.real_name %>)<% } %>
                            </span>
                            <span class="me-3">
                                <i class="fas fa-clock me-1"></i><%= new Date(post.created_at).toLocaleString('zh-CN') %>
                            </span>
                            <span class="badge category-badge" style="background-color: <%= post.category_color %>">
                                <%= post.category_name %>
                            </span>
                        </div>
                    </div>
                    <% if (user && user.id === post.user_id) { %>
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            操作
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/posts/<%= post.id %>/edit">
                                <i class="fas fa-edit me-2"></i>编辑
                            </a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger delete-post-btn" href="#" 
                                   data-post-id="<%= post.id %>" 
                                   data-post-title="<%= post.title %>">
                                <i class="fas fa-trash me-2"></i>删除
                            </a></li>
                        </ul>
                    </div>
                    <% } %>
                </div>
            </div>
            <div class="card-body">
                <!-- 课程信息 -->
                <% if (post.course_name || post.teacher_name || post.course_code || post.semester) { %>
                <div class="alert alert-info mb-3">
                    <h6><i class="fas fa-info-circle me-2"></i>课程信息</h6>
                    <div class="row">
                        <% if (post.course_name) { %>
                        <div class="col-md-6">
                            <strong>课程名称：</strong><%= post.course_name %>
                        </div>
                        <% } %>
                        <% if (post.teacher_name) { %>
                        <div class="col-md-6">
                            <strong>任课教师：</strong><%= post.teacher_name %>
                        </div>
                        <% } %>
                        <% if (post.course_code) { %>
                        <div class="col-md-6">
                            <strong>课程代码：</strong><%= post.course_code %>
                        </div>
                        <% } %>
                        <% if (post.semester) { %>
                        <div class="col-md-6">
                            <strong>学期：</strong><%= post.semester %>
                        </div>
                        <% } %>
                    </div>
                </div>
                <% } %>

                <!-- 帖子内容 -->
                <div class="post-content">
                    <%= post.content.replace(/\\n/g, '<br>') %>
                </div>

                <!-- 标签 -->
                <% if (post.tags && post.tags.length > 0) { %>
                <div class="tag-list mt-3">
                    <% post.tags.forEach(tag => { %>
                    <span class="tag-item">#<%= tag %></span>
                    <% }) %>
                </div>
                <% } %>
            </div>
            <div class="card-footer">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <div class="post-stats">
                            <span class="me-3"><i class="fas fa-eye"></i> <%= post.view_count %> 浏览</span>
                            <span class="me-3"><i class="fas fa-heart"></i> <%= post.like_count %> 点赞</span>
                            <span><i class="fas fa-comment"></i> <%= post.comment_count %> 评论</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex justify-content-end">
                            <div class="me-3">
                                <small class="text-muted">难度等级：</small>
                                <div class="difficulty-stars d-inline">
                                    <% for (let i = 1; i <= 5; i++) { %>
                                        <i class="<%= i <= post.difficulty_level ? 'fas' : 'far' %> fa-star"></i>
                                    <% } %>
                                </div>
                            </div>
                            <% if (user) { %>
                            <button class="btn btn-outline-primary btn-sm me-2 like-btn" data-post-id="<%= post.id %>">
                                <i class="far fa-heart"></i> 点赞
                            </button>
                            <button class="btn btn-outline-secondary btn-sm favorite-btn" data-post-id="<%= post.id %>">
                                <i class="far fa-bookmark"></i> 收藏
                            </button>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 评论区域 -->
        <div class="card">
            <div class="card-header">
                <h5><i class="fas fa-comments me-2"></i>评论 (<%= post.comment_count %>)</h5>
            </div>
            <div class="card-body">
                <% if (user) { %>
                <!-- 发表评论 -->
                <form class="mb-4">
                    <div class="mb-3">
                        <textarea class="form-control" rows="3" placeholder="写下你的评论..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-paper-plane me-2"></i>发表评论
                    </button>
                </form>
                <% } else { %>
                <div class="alert alert-info">
                    <a href="/auth/login">登录</a> 后可以发表评论
                </div>
                <% } %>

                <!-- 评论列表 -->
                <div id="comments-list">
                    <div class="text-center text-muted">
                        <i class="fas fa-comments fa-2x mb-2"></i>
                        <p>暂无评论，来发表第一个评论吧！</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <!-- 作者信息 -->
        <div class="card mb-4">
            <div class="card-header">
                <h6><i class="fas fa-user me-2"></i>作者信息</h6>
            </div>
            <div class="card-body text-center">
                <img src="<%= post.avatar %>" alt="<%= post.username %>" class="user-avatar-lg mb-3">
                <h6><%= post.username %></h6>
                <% if (post.real_name) { %>
                <p class="text-muted mb-2"><%= post.real_name %></p>
                <% } %>
                <small class="text-muted">
                    加入时间：<%= new Date(post.created_at).toLocaleDateString('zh-CN') %>
                </small>
            </div>
        </div>

        <!-- 相关帖子 -->
        <div class="card">
            <div class="card-header">
                <h6><i class="fas fa-list me-2"></i>相关帖子</h6>
            </div>
            <div class="card-body">
                <div class="text-center text-muted">
                    <i class="fas fa-search fa-2x mb-2"></i>
                    <p>暂无相关帖子</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// 删除帖子确认
document.addEventListener('DOMContentLoaded', function() {
    const deleteBtn = document.querySelector('.delete-post-btn');
    if (deleteBtn) {
        deleteBtn.addEventListener('click', function(e) {
            e.preventDefault();
            const postId = this.dataset.postId;
            const postTitle = this.dataset.postTitle;
            
            if (confirm('确定要删除帖子"' + postTitle + '"吗？此操作不可撤销。')) {
                fetch('/posts/' + postId + '/delete', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        window.location.href = '/posts';
                    } else {
                        alert('删除失败：' + data.message);
                    }
                })
                .catch(error => {
                    console.error('删除帖子错误:', error);
                    alert('删除失败，请稍后重试');
                });
            }
        });
    }
});
</script>
` }) %>
