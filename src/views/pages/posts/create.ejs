<%- include('../../layouts/main', { body: `
<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">
        <div class="card">
            <div class="card-header">
                <h4><i class="fas fa-plus me-2"></i>发布帖子</h4>
            </div>
            <div class="card-body">
                <!-- 错误消息 -->
                <% if (locals.errors && errors.length > 0) { %>
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        <% errors.forEach(error => { %>
                        <li><%= error.msg %></li>
                        <% }) %>
                    </ul>
                </div>
                <% } %>

                <form action="/posts/create" method="POST" class="needs-validation" novalidate>
                    <div class="row">
                        <div class="col-md-8">
                            <div class="mb-3">
                                <label for="title" class="form-label">标题 *</label>
                                <input type="text" 
                                       class="form-control" 
                                       id="title" 
                                       name="title" 
                                       value="<%= locals.formData ? formData.title || '' : '' %>"
                                       minlength="5"
                                       maxlength="200"
                                       required>
                                <div class="invalid-feedback">
                                    标题长度必须在5-200个字符之间
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="category_id" class="form-label">分类 *</label>
                                <select class="form-select" id="category_id" name="category_id" required>
                                    <option value="">请选择分类</option>
                                    <% categories.forEach(category => { %>
                                    <option value="<%= category.id %>" 
                                            <%= locals.formData && formData.category_id == category.id ? 'selected' : '' %>>
                                        <%= category.name %>
                                    </option>
                                    <% }) %>
                                </select>
                                <div class="invalid-feedback">
                                    请选择一个分类
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="content" class="form-label">内容 *</label>
                        <textarea class="form-control" 
                                  id="content" 
                                  name="content" 
                                  rows="8" 
                                  minlength="10"
                                  required><%= locals.formData ? formData.content || '' : '' %></textarea>
                        <div class="invalid-feedback">
                            内容至少需要10个字符
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="course_name" class="form-label">课程名称</label>
                                <input type="text" 
                                       class="form-control" 
                                       id="course_name" 
                                       name="course_name" 
                                       value="<%= locals.formData ? formData.course_name || '' : '' %>"
                                       maxlength="100">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="teacher_name" class="form-label">教师姓名</label>
                                <input type="text" 
                                       class="form-control" 
                                       id="teacher_name" 
                                       name="teacher_name" 
                                       value="<%= locals.formData ? formData.teacher_name || '' : '' %>"
                                       maxlength="50">
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="course_code" class="form-label">课程代码</label>
                                <input type="text" 
                                       class="form-control" 
                                       id="course_code" 
                                       name="course_code" 
                                       value="<%= locals.formData ? formData.course_code || '' : '' %>"
                                       maxlength="20">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="semester" class="form-label">学期</label>
                                <input type="text" 
                                       class="form-control" 
                                       id="semester" 
                                       name="semester" 
                                       value="<%= locals.formData ? formData.semester || '' : '' %>"
                                       placeholder="如：2024春季"
                                       maxlength="20">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="difficulty_level" class="form-label">难度等级</label>
                                <select class="form-select" id="difficulty_level" name="difficulty_level">
                                    <option value="1" <%= locals.formData && formData.difficulty_level == '1' ? 'selected' : '' %>>⭐ 简单</option>
                                    <option value="2" <%= locals.formData && formData.difficulty_level == '2' ? 'selected' : '' %>>⭐⭐ 一般</option>
                                    <option value="3" <%= locals.formData && formData.difficulty_level == '3' ? 'selected' : '' %>>⭐⭐⭐ 中等</option>
                                    <option value="4" <%= locals.formData && formData.difficulty_level == '4' ? 'selected' : '' %>>⭐⭐⭐⭐ 困难</option>
                                    <option value="5" <%= locals.formData && formData.difficulty_level == '5' ? 'selected' : '' %>>⭐⭐⭐⭐⭐ 极难</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="tags" class="form-label">标签</label>
                        <input type="text" 
                               class="form-control" 
                               id="tags" 
                               name="tags" 
                               value="<%= locals.formData ? formData.tags || '' : '' %>"
                               placeholder="用逗号分隔多个标签，如：数学,微积分,期末考试">
                        <div class="form-text">用逗号分隔多个标签，便于其他同学搜索</div>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" 
                               class="form-check-input" 
                               id="is_urgent" 
                               name="is_urgent" 
                               value="1"
                               <%= locals.formData && formData.is_urgent ? 'checked' : '' %>>
                        <label class="form-check-label" for="is_urgent">
                            <span class="badge bg-danger me-2">紧急</span>
                            这是一个紧急求助
                        </label>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="/posts" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-2"></i>返回列表
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-paper-plane me-2"></i>发布帖子
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
` }) %>
