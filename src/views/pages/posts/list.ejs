<%- include('../../layouts/main', { body: `
<!-- 页面标题和操作 -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>
            <% if (currentCategory) { %>
                <i class="<%= currentCategory.icon %> me-2" style="color: <%= currentCategory.color %>"></i>
                <%= currentCategory.name %>
            <% } else { %>
                <i class="fas fa-list me-2"></i>
                帖子列表
            <% } %>
        </h2>
        <p class="text-muted mb-0">共 <%= pagination.totalCount %> 个帖子</p>
    </div>
    <% if (user) { %>
    <a href="/posts/create" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>发布帖子
    </a>
    <% } %>
</div>

<!-- 筛选和搜索 -->
<div class="filter-section">
    <form method="GET" class="row g-3">
        <div class="col-md-3">
            <label for="category" class="form-label">分类</label>
            <select class="form-select" id="category" name="category">
                <option value="">所有分类</option>
                <% categories.forEach(category => { %>
                <option value="<%= category.id %>" <%= filters.category_id == category.id ? 'selected' : '' %>>
                    <%= category.name %> (<%= category.post_count %>)
                </option>
                <% }) %>
            </select>
        </div>
        
        <div class="col-md-3">
            <label for="search" class="form-label">搜索</label>
            <input type="text" 
                   class="form-control" 
                   id="search" 
                   name="search" 
                   placeholder="搜索标题、内容或课程..."
                   value="<%= filters.search || '' %>">
        </div>
        
        <div class="col-md-2">
            <label for="sort" class="form-label">排序</label>
            <select class="form-select" id="sort" name="sort">
                <option value="created_at" <%= filters.sort === 'created_at' ? 'selected' : '' %>>最新发布</option>
                <option value="view_count" <%= filters.sort === 'view_count' ? 'selected' : '' %>>浏览最多</option>
                <option value="like_count" <%= filters.sort === 'like_count' ? 'selected' : '' %>>点赞最多</option>
                <option value="comment_count" <%= filters.sort === 'comment_count' ? 'selected' : '' %>>评论最多</option>
            </select>
        </div>
        
        <div class="col-md-2">
            <label for="urgent" class="form-label">筛选</label>
            <select class="form-select" id="urgent" name="urgent">
                <option value="">全部</option>
                <option value="1" <%= filters.is_urgent == 1 ? 'selected' : '' %>>紧急求助</option>
            </select>
        </div>
        
        <div class="col-md-2">
            <label for="resolved" class="form-label">状态</label>
            <select class="form-select" id="resolved" name="resolved">
                <option value="">全部</option>
                <option value="0" <%= filters.is_resolved == 0 ? 'selected' : '' %>>未解决</option>
                <option value="1" <%= filters.is_resolved == 1 ? 'selected' : '' %>>已解决</option>
            </select>
        </div>
        
        <div class="col-12">
            <button type="submit" class="btn btn-outline-primary me-2">
                <i class="fas fa-search me-1"></i>搜索
            </button>
            <a href="/posts" class="btn btn-outline-secondary">
                <i class="fas fa-times me-1"></i>清除筛选
            </a>
        </div>
    </form>
</div>

<!-- 帖子列表 -->
<div class="row">
    <% if (posts.length > 0) { %>
        <% posts.forEach(post => { %>
        <div class="col-12">
            <div class="card post-card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8">
                            <!-- 帖子标题 -->
                            <h5 class="card-title">
                                <a href="/posts/<%= post.id %>" class="post-title">
                                    <%= post.title %>
                                </a>
                                <% if (post.is_urgent) { %>
                                <span class="badge bg-danger ms-2">紧急</span>
                                <% } %>
                                <% if (post.is_resolved) { %>
                                <span class="badge bg-success ms-2">已解决</span>
                                <% } %>
                            </h5>
                            
                            <!-- 帖子摘要 -->
                            <p class="post-summary text-muted mb-2">
                                <%= post.summary %>
                            </p>
                            
                            <!-- 课程信息 -->
                            <% if (post.course_name || post.teacher_name) { %>
                            <div class="mb-2">
                                <% if (post.course_name) { %>
                                <span class="badge bg-light text-dark me-1">
                                    <i class="fas fa-book me-1"></i><%= post.course_name %>
                                </span>
                                <% } %>
                                <% if (post.teacher_name) { %>
                                <span class="badge bg-light text-dark me-1">
                                    <i class="fas fa-user-tie me-1"></i><%= post.teacher_name %>
                                </span>
                                <% } %>
                            </div>
                            <% } %>
                            
                            <!-- 标签 -->
                            <% if (post.tags && post.tags.length > 0) { %>
                            <div class="tag-list mb-2">
                                <% post.tags.forEach(tag => { %>
                                <span class="tag-item">#<%= tag %></span>
                                <% }) %>
                            </div>
                            <% } %>
                            
                            <!-- 帖子元信息 -->
                            <div class="post-meta">
                                <img src="<%= post.avatar %>" alt="<%= post.username %>" class="user-avatar me-2">
                                <span class="me-3">
                                    <i class="fas fa-user me-1"></i><%= post.username %>
                                </span>
                                <span class="me-3">
                                    <i class="fas fa-clock me-1"></i><%= new Date(post.created_at).toLocaleString('zh-CN') %>
                                </span>
                                <span class="badge category-badge" style="background-color: <%= post.category_color %>">
                                    <%= post.category_name %>
                                </span>
                            </div>
                        </div>
                        
                        <div class="col-md-4">
                            <!-- 难度等级 -->
                            <div class="mb-2">
                                <small class="text-muted">难度等级：</small>
                                <div class="difficulty-stars">
                                    <% for (let i = 1; i <= 5; i++) { %>
                                        <i class="<%= i <= post.difficulty_level ? 'fas' : 'far' %> fa-star"></i>
                                    <% } %>
                                </div>
                            </div>
                            
                            <!-- 统计信息 -->
                            <div class="post-stats">
                                <div class="d-flex justify-content-between">
                                    <span><i class="fas fa-eye"></i> <%= post.view_count %></span>
                                    <span><i class="fas fa-heart"></i> <%= post.like_count %></span>
                                    <span><i class="fas fa-comment"></i> <%= post.comment_count %></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <% }) %>
    <% } else { %>
        <div class="col-12">
            <div class="empty-state">
                <i class="fas fa-inbox"></i>
                <h4>暂无帖子</h4>
                <p>还没有符合条件的帖子，试试调整筛选条件或者
                <% if (user) { %>
                    <a href="/posts/create">发布第一个帖子</a>
                <% } else { %>
                    <a href="/auth/register">注册账号</a>后发布帖子
                <% } %>
                </p>
            </div>
        </div>
    <% } %>
</div>

<!-- 分页 -->
<% if (pagination.totalPages > 1) { %>
<nav aria-label="帖子分页">
    <ul class="pagination justify-content-center">
        <% if (pagination.hasPrev) { %>
        <li class="page-item">
            <a class="page-link" href="?page=<%= pagination.currentPage - 1 %><%= Object.keys(filters).map(key => filters[key] ? '&' + key + '=' + encodeURIComponent(filters[key]) : '').join('') %>">
                上一页
            </a>
        </li>
        <% } %>
        
        <% for (let i = Math.max(1, pagination.currentPage - 2); i <= Math.min(pagination.totalPages, pagination.currentPage + 2); i++) { %>
        <li class="page-item <%= i === pagination.currentPage ? 'active' : '' %>">
            <a class="page-link" href="?page=<%= i %><%= Object.keys(filters).map(key => filters[key] ? '&' + key + '=' + encodeURIComponent(filters[key]) : '').join('') %>">
                <%= i %>
            </a>
        </li>
        <% } %>
        
        <% if (pagination.hasNext) { %>
        <li class="page-item">
            <a class="page-link" href="?page=<%= pagination.currentPage + 1 %><%= Object.keys(filters).map(key => filters[key] ? '&' + key + '=' + encodeURIComponent(filters[key]) : '').join('') %>">
                下一页
            </a>
        </li>
        <% } %>
    </ul>
</nav>
<% } %>
` }) %>
