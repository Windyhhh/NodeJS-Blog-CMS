<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - 学业互助平台</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <!-- 自定义样式 -->
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>
    <!-- 导航栏 -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="fas fa-graduation-cap me-2"></i>
                学业互助平台
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">首页</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/posts">帖子列表</a>
                    </li>
                    <% if (user) { %>
                    <li class="nav-item">
                        <a class="nav-link" href="/posts/create">发布帖子</a>
                    </li>
                    <% } %>
                </ul>

                <ul class="navbar-nav">
                    <% if (user) { %>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                            <img src="<%= user.avatar %>" alt="头像" class="rounded-circle me-1" width="24" height="24">
                            <%= user.username %>
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/auth/profile">个人资料</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form action="/auth/logout" method="POST" class="d-inline">
                                    <button type="submit" class="dropdown-item">退出登录</button>
                                </form>
                            </li>
                        </ul>
                    </li>
                    <% } else { %>
                    <li class="nav-item">
                        <a class="nav-link" href="/auth/login">登录</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/auth/register">注册</a>
                    </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <!-- 消息提示 -->
    <% if (message) { %>
    <div class="alert alert-<%= message.type === 'error' ? 'danger' : message.type %> alert-dismissible fade show" role="alert">
        <%= message.text %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>

    <!-- 主要内容 -->
    <main class="container my-4">
<!-- 欢迎横幅 -->
<div class="jumbotron bg-primary text-white rounded p-5 mb-4">
    <div class="container-fluid py-5">
        <h1 class="display-5 fw-bold">欢迎来到学业互助平台</h1>
        <p class="col-md-8 fs-4">在这里，大学生可以互相帮助，分享学习资源，解决学业问题，共同进步！</p>
        <% if (!user) { %>
        <a href="/auth/register" class="btn btn-light btn-lg">立即加入</a>
        <% } else { %>
        <a href="/posts/create" class="btn btn-light btn-lg">发布帖子</a>
        <% } %>
    </div>
</div>

<!-- 统计信息 -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <i class="fas fa-users fa-2x text-primary mb-2"></i>
                <h5 class="card-title">注册用户</h5>
                <p class="card-text display-6" id="userCount">-</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <i class="fas fa-file-alt fa-2x text-success mb-2"></i>
                <h5 class="card-title">帖子总数</h5>
                <p class="card-text display-6" id="postCount">-</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <i class="fas fa-comments fa-2x text-info mb-2"></i>
                <h5 class="card-title">评论总数</h5>
                <p class="card-text display-6" id="commentCount">-</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <i class="fas fa-tags fa-2x text-warning mb-2"></i>
                <h5 class="card-title">分类数量</h5>
                <p class="card-text display-6" id="categoryCount">-</p>
            </div>
        </div>
    </div>
</div>

<!-- 热门分类 -->
<div class="row mb-4">
    <div class="col-12">
        <h3 class="mb-3">热门分类</h3>
        <div class="row" id="popularCategories">
            <!-- 分类卡片将通过JavaScript动态加载 -->
        </div>
    </div>
</div>

<!-- 最新帖子 -->
<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3>最新帖子</h3>
            <a href="/posts" class="btn btn-outline-primary">查看更多</a>
        </div>
        <div id="latestPosts">
            <!-- 最新帖子将通过JavaScript动态加载 -->
        </div>
    </div>
</div>

<script>
// 页面加载完成后获取数据
document.addEventListener('DOMContentLoaded', function() {
    // 加载热门分类
    fetch('/categories/api/popular')
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                const container = document.getElementById('popularCategories');
                container.innerHTML = data.data.map(category =>
                    '<div class="col-md-4 mb-3">' +
                        '<div class="card h-100">' +
                            '<div class="card-body">' +
                                '<div class="d-flex align-items-center mb-2">' +
                                    '<i class="' + category.icon + ' fa-lg me-2" style="color: ' + category.color + '"></i>' +
                                    '<h5 class="card-title mb-0">' + category.name + '</h5>' +
                                '</div>' +
                                '<p class="card-text text-muted">' + category.description + '</p>' +
                                '<div class="d-flex justify-content-between align-items-center">' +
                                    '<small class="text-muted">' + category.post_count + ' 个帖子</small>' +
                                    '<a href="/posts?category=' + category.id + '" class="btn btn-sm btn-outline-primary">查看</a>' +
                                '</div>' +
                            '</div>' +
                        '</div>' +
                    '</div>'
                ).join('');
                
                // 更新分类数量
                document.getElementById('categoryCount').textContent = data.data.length;
            }
        })
        .catch(error => {
            console.error('加载热门分类失败:', error);
        });

    // 模拟统计数据（实际项目中应该从API获取）
    setTimeout(() => {
        document.getElementById('userCount').textContent = '1,234';
        document.getElementById('postCount').textContent = '5,678';
        document.getElementById('commentCount').textContent = '12,345';
    }, 500);

    // 模拟最新帖子数据
    setTimeout(() => {
        const latestPosts = document.getElementById('latestPosts');
        latestPosts.innerHTML =
            '<div class="card">' +
                '<div class="card-body">' +
                    '<p class="text-muted mb-2">暂无最新帖子数据，请<a href="/posts">查看帖子列表</a>或<a href="/posts/create">发布新帖子</a>。</p>' +
                '</div>' +
            '</div>';
    }, 800);
});
</script>

    </main>

    <!-- 页脚 -->
    <footer class="bg-light py-4 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <h5>学业互助平台</h5>
                    <p class="text-muted">帮助大学生互相学习，共同进步</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="text-muted">
                        &copy; 2024 学业互助平台. All rights reserved.
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- 自定义脚本 -->
    <script src="/js/main.js"></script>
</body>
</html>
